# =============================================================================
# drive-sync — example configuration
# Copy to ~/.config/drive-sync/config.yaml and adjust for your environment.
# =============================================================================

rclone:
  remote_name: "my-remote"          # name you gave the remote in `rclone config`
  remote_root: "Sync"               # top-level folder inside the remote
  binary: "rclone"
  global_flags:
    - "--transfers=4"
    - "--checkers=8"
    - "--retries=3"
    - "--low-level-retries=10"
    - "--track-renames"
  # Detecção de flakiness transitória do provedor (ADR-016 · #35/#46/#79): sob um
  # storm ativo, um erro que carrega uma assinatura de storm-colateral — `Status=5xx`
  # (auth OU block/storage) ou `400 Code=2003` de upload-vazio — é reclassificado
  # para `proton_infra` (recovery = aguardar, sem reauth), com ou sem par de auth
  # (#79). Auto-resume gated por probe. Divergência-genuína de bisync (rc=1
  # too-many-deletes) coincidente com storm NÃO é mascarada. Defaults de 2 incidentes.
  infra_storm_threshold: 5          # nº de sinais de storm numa janela para disparar (>= 1)
  infra_window_seconds: 600         # janela deslizante do detector, em segundos (> 0)

  # #45 — kill switch por job rclone. Um job que ultrapassa este limite é morto
  # (SIGTERM → SIGKILL) e o folder entra em degraded (libera o lock serializado
  # do ADR-001 do caso degenerado — no incidente 2026-05-29 um único bisync sem
  # excludes segurou o lock por 14h). Default 7200 (2h); 0 desliga. Se um folder
  # legitimamente demora mais que isso, suba o valor OU use o override per-folder
  # abaixo — um sync legítimo morto por engano fica VISÍVEL como `[STUCK_JOB]`.
  max_job_runtime_seconds: 7200
  # Auto-recuperação data-safe de rc=7 stale-listings (ADR-019, #47). Quando um
  # bisync aborta com "cannot find prior Path1 or Path2 listings" (estado .lst
  # morto por queda de rede/storm 5xx no meio de um bisync longo) E um dry-run
  # prova que o --resync seria união no-op (0 transfers, 0 deleções), o daemon
  # reconstrói o baseline sozinho em vez de ficar degradado até recovery manual.
  # Gated por prova data-safe: qualquer divergência → NÃO age, permanece degradado.
  # true (default). false = comportamento legado (loga BISYNC_FAIL, recovery manual).
  auto_resync_stale_listings: true

# -----------------------------------------------------------------------------
# git_handling options (ADR-008):
#   auto    — scan + `git remote -v` decide per repo (default for code folders).
#             Repo com remote → skip; repo sem remote → bundle. Repo_overrides
#             dá precedência total caso operador queira forçar.
#   skip    — folder inteiro fora do sync; marca sucesso para não disparar
#             staleness (ADR-005).
#   bundle  — bundle por-repo (recursivo). Útil para folder onde o repo é a raiz
#             E é local-only (caso `dev-scripts`), ou para repo com `.git/` na
#             casa dos GB.
#   plain   — bisync puro sem excludes git (folders não-git: Documents, Pictures,
#             library, videos).
#
# auto_exclude: true adiciona globs comuns de build artifacts (node_modules,
# .venv, etc.) ao bisync. Aplica em modos auto/plain; bundle ignora.
#
# cooldown_seconds: 0 (default, disabled). Quando > 0, rate-limita o folder
# independente de debounce_seconds e periodic_full_sync_seconds — no máximo
# 1 sync por janela, contada do início. Eventos no meio são absorvidos. Gate
# vale tanto para watcher quanto para periodic_full_sync (ADR-004). Caso típico:
# git_handling: bundle em repo com .git/ multi-GB (rclone não faz delta upload
# de blob no protondrive — re-upload integral por job).
#
# repo_overrides (ADR-008): override por repo descoberto no auto-scan.
# Schema: [{repo_subpath, mode: skip|bundle}]. Precedência total sobre
# auto-detect; útil para forçar bundle quando o remote é fictício (fork
# deletado, mirror read-only) ou para excluir repo experimental do sync.
#
# subpath_overrides (ADR-006): override de git_handling em subpath arbitrário.
# Schema: [{subpath, git_handling: skip|bundle|plain}]. Coexiste com
# repo_overrides; loader rejeita sobreposição na mesma lista.
#
# ESPELHO-POR-DEFAULT (ADR-020): remote_subpath DEVE espelhar o nome/estrutura do
# local_path (o leaf remoto = o nome local; prefixo estrutural OK). Toda divergência
# é exclude: explícito OU motivo registrado (ADR) — nunca renomeação silenciosa.
# Renome de remoto: SEMPRE via DirMove server-side (rclone move), nunca flip de
# remote_subpath (isso causa rc=7 — ADR-020 §Consequências, incidente #54).
# -----------------------------------------------------------------------------
folders:

  # ---------- Code (repos git com remote → skip; sem remote → bundle) ----------
  - name: "dev-projects"
    local_path: "~/dev/projects"
    remote_subpath: "dev/projects"
    git_handling: "auto"
    auto_exclude: true
    debounce_seconds: 40
    exclude:
      - "*.local"
    # repo_overrides (ADR-008): force bundle em fork desconfiável.
    # repo_overrides:
    #   - repo_subpath: "fork-experimental"
    #     mode: "bundle"
    # subpath_overrides (ADR-006): override em path não-repo.
    # subpath_overrides:
    #   - subpath: "scratch"
    #     git_handling: "plain"

  - name: "dev-scripts"
    local_path: "~/dev/scripts"
    remote_subpath: "dev/scripts"
    # Caso real: folder.local_path é ele próprio um repo local-only — bundle do root
    # captura o pacote inteiro (worktree + .git/). cooldown alto pra evitar re-upload
    # frequente.
    git_handling: "bundle"
    cooldown_seconds: 10800           # 3h
    auto_exclude: true
    debounce_seconds: 40
    # #45 — override do kill switch para ESTE folder. Ausente = herda o global
    # rclone.max_job_runtime_seconds; 0 = desliga só aqui (ex.: um folder enorme
    # cujo sync legítimo excede o default global).
    # max_job_runtime_seconds: 0

  - name: "dotfiles"
    local_path: "~/.dotfiles"
    remote_subpath: "dotfiles"
    git_handling: "auto"
    auto_exclude: true
    debounce_seconds: 40

  # ---------- Documents & media (folders não-git → plain) ----------
  - name: "documents"
    local_path: "~/Documents"
    remote_subpath: "documents"
    git_handling: "plain"
    auto_exclude: false
    debounce_seconds: 10
    exclude:
      - "*.tmp"
      - "~$*"                       # Office/LibreOffice locks

  - name: "library"
    local_path: "~/Library"
    remote_subpath: "library"
    git_handling: "plain"
    auto_exclude: false
    debounce_seconds: 60
    exclude:
      - "**/.zotero/**"
      - "*.tmp"

  # ---------- Pictures ----------
  - name: "pictures-photos"
    local_path: "~/Pictures/Photos"
    remote_subpath: "pictures/photos"
    git_handling: "plain"
    auto_exclude: false
    debounce_seconds: 120
    exclude:
      - "*.tmp"
      - "**/.thumbnails/**"

  - name: "pictures-screenshots"
    local_path: "~/Pictures/Screenshots"
    remote_subpath: "pictures/screenshots"
    git_handling: "plain"
    auto_exclude: false
    debounce_seconds: 5

  - name: "pictures-assets"
    local_path: "~/Pictures/Assets"
    remote_subpath: "pictures/assets"
    git_handling: "plain"
    auto_exclude: false
    debounce_seconds: 15

  # ---------- Videos ----------
  - name: "videos"
    local_path: "~/Videos"
    remote_subpath: "videos"
    git_handling: "plain"
    auto_exclude: false
    debounce_seconds: 180
    exclude:
      - "*.tmp"
      - "*.part"

# -----------------------------------------------------------------------------
# bundle mode infra (compartilhada por git_handling: auto e bundle).
# -----------------------------------------------------------------------------
git:
  bundles_dir: "~/.cache/drive-sync/bundles"
  bundle_suffix: ".gitbundle"
  bundle_all: true
  recursive_detection: true
  max_recursion_depth: 6

watcher:
  queue_size: 2000
  max_concurrent_jobs: 3
  periodic_full_sync_seconds: 3600
  startup_delay_seconds: 30
  # Pasta sem bisync bem-sucedido há > N segundos vira degraded — STATUS agregada
  # via sd_notify + notify-send + log [FOLDER_DEGRADED]. Per-folder, sem pausa
  # global (escopo distinto do auth degraded de ADR-003). Default 12h (43200s).
  # Use 0 para desligar (opt-out). Quando > 0, exige periodic_full_sync_seconds > 0
  # (detecção piggyback no loop periódico — ADR-005).
  folder_staleness_threshold_seconds: 43200

dedupe:
  skip_subpaths_of_configured_folders: true

# Audit de cobertura (#56 / ADR-015): em `drive-sync --check`, avisa (warn, NÃO
# fatal — não bloqueia) sobre subárvores IRMÃS dos folders configurados que nenhum
# folder cobre — conteúdo local não backup-eado (pegaria o caso Screenshots-fora-do-
# backup no próximo --check). Sinal, não ação: o operador cobre (novo folders:) ou
# declara intencionalmente-fora em `allow`. `git_handling` é irrelevante aqui — todo
# local_path declarado conta como "conhecido", inclusive skip/bundle.
coverage_audit:
  enabled: true
  # roots (#77 / ADR-021, modelo A): diretórios escaneados INDEPENDENTE de haver um
  # local_path configurado sob eles. Fecha o ponto-cego do modelo B (siblings): um
  # top-level SEM sibling configurado — ex.: um filho-direto de `$HOME` como `~/mneme`
  # — nunca entraria no universo derivado-de-siblings. Declarar `$HOME` aqui faz o
  # PRÓXIMO gap desse tipo se auto-surfar, mesmo que nenhum folder sob a root mude.
  # Vazio (default) = só modelo B. CUIDADO: escanear `$HOME` exige `allow` robusta
  # (globs abaixo) — senão os dotdirs de env-stack afogam o sinal.
  roots: []
  #  - "~"                    # audita filhos-diretos de $HOME (requer allow-globs)
  #  - "/storage"
  #
  # allow: paths intencionalmente-fora-de-cobertura. Duas formas:
  #   - LITERAL: casa exato OU subpath (ex.: "/storage/tools" cobre tudo sob ele).
  #   - GLOB (contém `*?[`, #77/ADR-021): casado por fnmatch contra o path do filho.
  #     Necessário para tornar a root `$HOME` usável — silencia os dotdirs de
  #     env-stack (chezmoi/dotfiles, não trabalho do drive-sync) sem enumerá-los um a
  #     um. Converge com os `exclude:` do #55/ADR-020 (exclusão-por-exceção).
  #     CAVEAT: um glob casa através de `/` (`~/.*` silencia também aninhados); e um
  #     path LITERAL cujo dir tenha `*?[` no nome (raro) é lido como glob e pode não
  #     casar — nesse caso use o path do dir-pai sem o metachar. Ver ADR-021.
  allow: []
  #  - "/storage/tools"       # literal — reproduzível, fora de quota
  #  - "/storage/3. Resources"
  #  - "~/.*"                 # glob — todos os dotdirs de $HOME
  #  - "~/.local/share/*"     # glob — env-stack sob .local/share
  #  - "~/Downloads"          # literal — não backup-eado por escolha

# Probe periódico do backend para detectar falha de auth antes que um job real
# falhe (Code=8002/9001 do protondrive). Em sessão saudável, gera 1 chamada
# `rclone about` por intervalo. Desative em máquinas que não devem fazer
# chamada periódica ao backend (offline, CI).
health_check:
  enabled: true
  interval_seconds: 3600

logging:
  level: "INFO"
  file: "~/.local/state/drive-sync/drive-sync.log"
  max_bytes: 10485760               # 10 MiB
  backup_count: 5
  console: true
