# =============================================================================
# drive-sync — example configuration
# Copy to ~/.config/drive-sync/config.yaml and adjust for your environment.
# =============================================================================

rclone:
  remote_name: "my-remote"          # name you gave the remote in `rclone config`
  remote_root: "Sync"               # top-level folder inside the remote
  binary: "rclone"
  global_flags:
    - "--transfers=4"
    - "--checkers=8"
    - "--retries=3"
    - "--low-level-retries=10"
    - "--track-renames"

# -----------------------------------------------------------------------------
# git_handling options (ADR-008):
#   auto    — scan + `git remote -v` decide per repo (default for code folders).
#             Repo com remote → skip; repo sem remote → bundle. Repo_overrides
#             dá precedência total caso operador queira forçar.
#   skip    — folder inteiro fora do sync; marca sucesso para não disparar
#             staleness (ADR-005).
#   bundle  — bundle por-repo (recursivo). Útil para folder onde o repo é a raiz
#             E é local-only (caso `dev-scripts`), ou para repo com `.git/` na
#             casa dos GB.
#   plain   — bisync puro sem excludes git (folders não-git: Documents, Pictures,
#             library, videos).
#
# auto_exclude: true adiciona globs comuns de build artifacts (node_modules,
# .venv, etc.) ao bisync. Aplica em modos auto/plain; bundle ignora.
#
# cooldown_seconds: 0 (default, disabled). Quando > 0, rate-limita o folder
# independente de debounce_seconds e periodic_full_sync_seconds — no máximo
# 1 sync por janela, contada do início. Eventos no meio são absorvidos. Gate
# vale tanto para watcher quanto para periodic_full_sync (ADR-004). Caso típico:
# git_handling: bundle em repo com .git/ multi-GB (rclone não faz delta upload
# de blob no protondrive — re-upload integral por job).
#
# repo_overrides (ADR-008): override por repo descoberto no auto-scan.
# Schema: [{repo_subpath, mode: skip|bundle}]. Precedência total sobre
# auto-detect; útil para forçar bundle quando o remote é fictício (fork
# deletado, mirror read-only) ou para excluir repo experimental do sync.
#
# subpath_overrides (ADR-006): override de git_handling em subpath arbitrário.
# Schema: [{subpath, git_handling: skip|bundle|plain}]. Coexiste com
# repo_overrides; loader rejeita sobreposição na mesma lista.
# -----------------------------------------------------------------------------
folders:

  # ---------- Code (repos git com remote → skip; sem remote → bundle) ----------
  - name: "dev-projects"
    local_path: "~/dev/projects"
    remote_subpath: "dev/projects"
    git_handling: "auto"
    auto_exclude: true
    debounce_seconds: 40
    exclude:
      - "*.local"
    # repo_overrides (ADR-008): force bundle em fork desconfiável.
    # repo_overrides:
    #   - repo_subpath: "fork-experimental"
    #     mode: "bundle"
    # subpath_overrides (ADR-006): override em path não-repo.
    # subpath_overrides:
    #   - subpath: "scratch"
    #     git_handling: "plain"

  - name: "dev-scripts"
    local_path: "~/dev/scripts"
    remote_subpath: "dev/scripts"
    # Caso real: folder.local_path é ele próprio um repo local-only — bundle do root
    # captura o pacote inteiro (worktree + .git/). cooldown alto pra evitar re-upload
    # frequente.
    git_handling: "bundle"
    cooldown_seconds: 10800           # 3h
    auto_exclude: true
    debounce_seconds: 40

  - name: "dotfiles"
    local_path: "~/.dotfiles"
    remote_subpath: "dotfiles"
    git_handling: "auto"
    auto_exclude: true
    debounce_seconds: 40

  # ---------- Documents & media (folders não-git → plain) ----------
  - name: "documents"
    local_path: "~/Documents"
    remote_subpath: "documents"
    git_handling: "plain"
    auto_exclude: false
    debounce_seconds: 10
    exclude:
      - "*.tmp"
      - "~$*"                       # Office/LibreOffice locks

  - name: "library"
    local_path: "~/Library"
    remote_subpath: "library"
    git_handling: "plain"
    auto_exclude: false
    debounce_seconds: 60
    exclude:
      - "**/.zotero/**"
      - "*.tmp"

  # ---------- Pictures ----------
  - name: "pictures-photos"
    local_path: "~/Pictures/Photos"
    remote_subpath: "pictures/photos"
    git_handling: "plain"
    auto_exclude: false
    debounce_seconds: 120
    exclude:
      - "*.tmp"
      - "**/.thumbnails/**"

  - name: "pictures-screenshots"
    local_path: "~/Pictures/Screenshots"
    remote_subpath: "pictures/screenshots"
    git_handling: "plain"
    auto_exclude: false
    debounce_seconds: 5

  - name: "pictures-assets"
    local_path: "~/Pictures/Assets"
    remote_subpath: "pictures/assets"
    git_handling: "plain"
    auto_exclude: false
    debounce_seconds: 15

  # ---------- Videos ----------
  - name: "videos"
    local_path: "~/Videos"
    remote_subpath: "videos"
    git_handling: "plain"
    auto_exclude: false
    debounce_seconds: 180
    exclude:
      - "*.tmp"
      - "*.part"

# -----------------------------------------------------------------------------
# bundle mode infra (compartilhada por git_handling: auto e bundle).
# -----------------------------------------------------------------------------
git:
  bundles_dir: "~/.cache/drive-sync/bundles"
  bundle_suffix: ".gitbundle"
  bundle_all: true
  recursive_detection: true
  max_recursion_depth: 6

watcher:
  queue_size: 2000
  max_concurrent_jobs: 3
  periodic_full_sync_seconds: 3600
  startup_delay_seconds: 30
  # Pasta sem bisync bem-sucedido há > N segundos vira degraded — STATUS agregada
  # via sd_notify + notify-send + log [FOLDER_DEGRADED]. Per-folder, sem pausa
  # global (escopo distinto do auth degraded de ADR-003). Default 12h (43200s).
  # Use 0 para desligar (opt-out). Quando > 0, exige periodic_full_sync_seconds > 0
  # (detecção piggyback no loop periódico — ADR-005).
  folder_staleness_threshold_seconds: 43200

dedupe:
  skip_subpaths_of_configured_folders: true

# Probe periódico do backend para detectar falha de auth antes que um job real
# falhe (Code=8002/9001 do protondrive). Em sessão saudável, gera 1 chamada
# `rclone about` por intervalo. Desative em máquinas que não devem fazer
# chamada periódica ao backend (offline, CI).
health_check:
  enabled: true
  interval_seconds: 3600

logging:
  level: "INFO"
  file: "~/.local/state/drive-sync/drive-sync.log"
  max_bytes: 10485760               # 10 MiB
  backup_count: 5
  console: true
