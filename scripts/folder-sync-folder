#!/usr/bin/env python3
"""drive-sync-folder — adiciona/remove/lista pastas no config.yaml.

Atende ao requisito de "permitir ao usuário adicionar ou remover pastas-alvo
de forma facilitada". Reaplica também o reload do serviço systemd.

Uso:
  drive-sync-folder add  --name docs --path ~/Docs --remote Documentos
  drive-sync-folder rm   --name docs
  drive-sync-folder list
"""
from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

import yaml

CFG_PATH = Path(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
) / "drive-sync" / "config.yaml"


def _load() -> dict:
    if not CFG_PATH.exists():
        sys.exit(f"erro: config não encontrado em {CFG_PATH}")
    return yaml.safe_load(CFG_PATH.read_text(encoding="utf-8")) or {}


def _save(data: dict) -> None:
    CFG_PATH.write_text(yaml.safe_dump(data, sort_keys=False, allow_unicode=True), encoding="utf-8")


def _reload_service() -> None:
    """Pede ao systemd para reiniciar o serviço, se estiver ativo."""
    r = subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", "drive-sync.service"]
    )
    if r.returncode == 0:
        subprocess.run(["systemctl", "--user", "restart", "drive-sync.service"], check=False)
        print("→ Serviço reiniciado.")


def cmd_list(_args: argparse.Namespace) -> int:
    data = _load()
    folders = data.get("folders", [])
    if not folders:
        print("(nenhuma pasta configurada)")
        return 0
    for f in folders:
        flag = " " if f.get("enabled", True) else "✗"
        print(f"  [{flag}] {f['name']:<20} {f['local_path']}  →  {f['remote_subpath']}")
    return 0


def cmd_add(args: argparse.Namespace) -> int:
    data = _load()
    folders = data.setdefault("folders", [])
    if any(f["name"] == args.name for f in folders):
        sys.exit(f"erro: já existe uma tarefa com nome {args.name!r}")

    folders.append({
        "name": args.name,
        "local_path": args.path,
        "remote_subpath": args.remote,
        "enabled": True,
        "git_mode": args.git_mode,
        "auto_exclude": not args.no_auto_exclude,
        "exclude": args.exclude or [],
        "debounce_seconds": args.debounce,
    })
    _save(data)
    print(f"✓ Tarefa {args.name!r} adicionada.")
    _reload_service()
    return 0


def cmd_rm(args: argparse.Namespace) -> int:
    data = _load()
    folders = data.get("folders", [])
    n_before = len(folders)
    data["folders"] = [f for f in folders if f["name"] != args.name]
    if len(data["folders"]) == n_before:
        sys.exit(f"erro: tarefa {args.name!r} não existe")
    _save(data)
    print(f"✓ Tarefa {args.name!r} removida.")
    _reload_service()
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="drive-sync-folder")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="lista tarefas configuradas").set_defaults(func=cmd_list)

    a = sub.add_parser("add", help="adiciona uma nova tarefa")
    a.add_argument("--name", required=True)
    a.add_argument("--path", required=True, help="caminho local (aceita ~)")
    a.add_argument("--remote", required=True, help="subpath dentro do remote")
    a.add_argument("--git-mode", choices=["off", "bisync", "bundle"], default="bisync")
    a.add_argument("--no-auto-exclude", action="store_true",
                   help="desliga os excludes automáticos de artefatos de build")
    a.add_argument("--exclude", nargs="*", default=None, help="globs a excluir")
    a.add_argument("--debounce", type=int, default=5)
    a.set_defaults(func=cmd_add)

    r = sub.add_parser("rm", help="remove uma tarefa")
    r.add_argument("--name", required=True)
    r.set_defaults(func=cmd_rm)

    args = p.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
